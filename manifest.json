{
  "Name": "Stream Mixer",
  "Author": "koconnorgit",
  "Version": "2.2.0",
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "stream-mixer-x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu": "stream-mixer-aarch64-unknown-linux-gnu"
  },
  "CodePathLin": "stream-mixer-x86_64-unknown-linux-gnu",
  "OS": [
    {
      "Platform": "linux"
    }
  ],
  "Category": "Stream Mixer",
  "Description": "Per-app volume mixer for Stream Deck on Linux: keypad grids, Stream Deck + dials with live LCD art, touch-to-mute, and volume memory presets.",
  "Icon": "img/icon",
  "PropertyInspectorPath": "pi.html",
  "Actions": [
    {
      "Icon": "img/grid-slider",
      "Name": "Mixer Channel",
      "UUID": "io.github.koconnorgit.stream-mixer.volctrl",
      "Tooltip": "One mixer channel per column (keypad) or per dial (encoder); fill the deck with these",
      "Controllers": ["Keypad", "Encoder"],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust volume",
          "Push": "Toggle mute",
          "Touch": "Toggle mute",
          "LongTouch": "Dismiss stream"
        }
      },
      "States": [
        {}
      ]
    },
    {
      "Icon": "img/memory",
      "Name": "Volume Memory",
      "UUID": "io.github.koconnorgit.stream-mixer.memory",
      "Tooltip": "Hold to store every source's volume and mute; tap to recall them",
      "PropertyInspectorPath": "pi-memory.html",
      "Controllers": ["Keypad"],
      "States": [
        {}
      ]
    },
    {
      "Icon": "img/memory-clear",
      "Name": "Clear Preset",
      "UUID": "io.github.koconnorgit.stream-mixer.memory-clear",
      "Tooltip": "Erase the stored volumes of the currently loaded memory preset",
      "PropertyInspectorPath": "pi-memory-clear.html",
      "Controllers": ["Keypad"],
      "States": [
        {}
      ]
    }
  ]
}
