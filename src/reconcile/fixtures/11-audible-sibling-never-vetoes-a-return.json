{
  "name": "11 muting tab A while tab B (the active session) stays audible: B wears its identity on a live channel, so it never vetoes A's return",
  "steps": [
    { "at_ms": 0,
      "sessions": [
        {"pid":1,"key":"ttv:a","title":"a live","artist":"A","active_ms":0},
        {"pid":1,"key":"ttv:b","title":"b live","artist":"B","active_ms":5000} ],
      "apps":   [ {"uid":10,"pid":1,"name":"A - Twitch"}, {"uid":11,"pid":1,"name":"B - Twitch"} ],
      "expect": [ {"uid":10,"identity":"ttv:a"}, {"uid":11,"identity":"ttv:b"} ] },
    { "at_ms": 30000,
      "apps":   [ {"uid":11,"pid":1,"name":"B - Twitch"} ],
      "expect": [ {"uid":11,"identity":"ttv:b"} ] },
    { "at_ms": 30400,
      "apps":   [ {"uid":11,"pid":1,"name":"B - Twitch"}, {"uid":12,"pid":1,"name":"AudioStream"} ],
      "expect": [ {"uid":11,"identity":"ttv:b"}, {"uid":12,"identity":"ttv:a","name":"A - Twitch"} ] }
  ]
}
